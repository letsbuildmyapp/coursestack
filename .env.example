# Firebase web SDK config — public, safe to bundle
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: connect to local emulators
VITE_USE_EMULATORS=false

# Stripe publishable key (public)
VITE_STRIPE_PUBLISHABLE_KEY=

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry DSN (public)
VITE_SENTRY_DSN=

# DEMO MODE — when no Firebase API key is set, the app falls back to local mock data
# so you can run the UI without a backend. Real auth/payments require keys.
