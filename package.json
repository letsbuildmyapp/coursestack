{
  "name": "coursestack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "deploy:staging": "npm run build && firebase deploy --only hosting:staging,firestore:rules,storage,functions",
    "deploy:prod": "npm run build && firebase deploy --only hosting:prod,firestore:rules,storage,functions",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
